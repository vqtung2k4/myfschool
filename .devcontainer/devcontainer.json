// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "Flutter (myfschool)",
  "image": "ghcr.io/thephaseless/devcontainers/flutter:latest",

  // Run flutter pub get after the container is created so all dependencies are ready immediately.
  "postCreateCommand": "flutter pub get",

  // Forward the Flutter web dev server port so you can preview the app in your browser.
  "forwardPorts": [8080],

  "customizations": {
    "vscode": {
      // Essential VS Code extensions for Flutter / Dart development.
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens"
      ],
      "settings": {
        // Use the Flutter SDK bundled in the container image.
        "dart.flutterSdkPath": "/flutter",
        // Auto-format Dart files on save.
        "editor.formatOnSave": true,
        "[dart]": {
          "editor.defaultFormatter": "Dart-Code.dart-code",
          "editor.formatOnSave": true,
          "editor.rulers": [80]
        },
        // Show full Flutter run output in the terminal.
        "dart.openDevTools": "flutter",
        "dart.debugExternalPackageLibraries": false,
        "dart.debugSdkLibraries": false
      }
    }
  }
}